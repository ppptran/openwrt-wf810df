ecm_interface: treat tag_8021q DSA user ports as VLAN uppers of the conduit

A DSA switch driven by a tag_8021q tagger talks to its CPU port in plain
802.1Q: a standalone user port carries its own VID, the ports of a
VLAN-unaware bridge share the bridge's VID. On the wire a user port is
therefore an 802.1Q sub-interface of the conduit, and this is how the
accelerated path has to see it.

ECM 12.5 had no DSA awareness at all: a DSA user port was a plain ethernet
leaf with no NSS interface number, so every routed flow through it was
refused by the front end (ecm_nss_ported_ipv4.c, "First interface in each
must be a known nss interface"), measured on this board as accel_mode -2
with the switch conduit armed as NSS interface 1.

Now a user port whose switch has a tag_8021q context is a VLAN iface: the
tag is the tagger's VID for the port (or its bridge) with the standard
TPID, and the interface hierarchy continues to the conduit as the ethernet
leaf - the same shape as eth0.<vid> on a plain trunk, which the firmware
forwards at line rate. Only the VLAN-specific helpers that read
vlan_dev_priv() are guarded, because such an iface is not an 802.1Q net
device: the egress QoS mask in the NSS frontends and the accel stats
update.

An 802.1Q upper of such a port (wan.35, the usual PPPoE ISP layout) is on
the wire with its own tag only - the switch carries that VLAN through and
the tagger passes it untouched - so the hierarchy steps from the upper
straight to the conduit and the rule gets that one VLAN, the eth0.35
shape, not the port's VID stacked under it.

Ported from kuncy7's 0051 to the 12.5 tree: its bridge-VLAN membership
hunk does not apply (this ECM has no ECM_BRIDGE_VLAN_FILTERING code paths
used here), the rest is unchanged.

Compiled out on kernels without CONFIG_NET_DSA (the tag_8021q library is part
of dsa_core); no change for any device that is not a tag_8021q DSA port.

diff -ruN a/ecm_interface.c b/ecm_interface.c
--- a/ecm_interface.c	2026-10-24 21:50:27.886003924 +0700
+++ b/ecm_interface.c	2026-10-24 21:50:53.786332953 +0700
@@ -78,6 +78,10 @@
 #include <linux/../../net/8021q/vlan.h>
 #include <linux/if_vlan.h>
 #endif
+#if IS_ENABLED(CONFIG_NET_DSA)
+#include <linux/dsa/8021q.h>
+#include <net/dsa.h>
+#endif
 #ifdef ECM_INTERFACE_PPP_ENABLE
 #include <linux/if_pppox.h>
 #ifdef ECM_INTERFACE_L2TPV2_ENABLE
@@ -321,13 +325,78 @@
 }
 EXPORT_SYMBOL(ecm_interface_get_and_hold_dev_master);
 
+#if IS_ENABLED(CONFIG_NET_DSA)
+/*
+ * ecm_interface_dsa_8021q_conduit()
+ *	The conduit of a DSA user port whose switch talks to the CPU in plain
+ *	802.1Q (a tag_8021q tagger), NULL for any other net device.
+ *
+ * On the wire such a port is a VLAN upper of its conduit: frames arrive on
+ * and leave the conduit carrying the VID the tagger assigned to the port
+ * (or to the port's bridge), exactly like an 802.1Q sub-interface. A rule
+ * that names the port's own interface number instead is accepted by the
+ * NSS firmware but never transmits (measured on IPQ5018 + QCA8337 with the
+ * qca-8021q tagger).
+ */
+static struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev)) {
+		return NULL;
+	}
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR_OR_NULL(dp) || !dp->ds || !dp->ds->tag_8021q_ctx || !dp->cpu_dp) {
+		return NULL;
+	}
+
+	if (vid) {
+		if (dp->bridge && dp->bridge->tx_fwd_offload) {
+			*vid = dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+		} else {
+			*vid = dsa_tag_8021q_standalone_vid(dp);
+		}
+	}
+
+	return dp->cpu_dp->conduit;
+}
+#else
+static inline struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	return NULL;
+}
+#endif
+
+/*
+ * ecm_interface_is_vlan_dev()
+ *	An 802.1Q sub-interface, or a DSA port that looks like one on the wire.
+ */
+static inline bool ecm_interface_is_vlan_dev(struct net_device *dev)
+{
+	return is_vlan_dev(dev) || (ecm_interface_dsa_8021q_conduit(dev, NULL) != NULL);
+}
+
 /*
  * ecm_interface_vlan_real_dev()
  *	Return immediate VLAN net device or Physical device pointer
  */
 static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
 {
-	return vlan_dev_next_dev(vlan_dev);
+	if (is_vlan_dev(vlan_dev)) {
+		struct net_device *real_dev = vlan_dev_next_dev(vlan_dev);
+		struct net_device *conduit = ecm_interface_dsa_8021q_conduit(real_dev, NULL);
+
+		/*
+		 * An 802.1Q upper of a tag_8021q DSA port (wan.35 for a PPPoE
+		 * ISP) is on the wire with its own tag only: the switch carries
+		 * that VLAN through and the tagger leaves it alone. Step over the
+		 * port to the conduit, so the rule gets one VLAN, not two.
+		 */
+		return conduit ? conduit : real_dev;
+	}
+
+	return ecm_interface_dsa_8021q_conduit(vlan_dev, NULL);
 }
 
 /*
@@ -3144,14 +3213,25 @@
 		/*
 		 * VLAN?
 		 */
-		if (is_vlan_dev(dev)) {
+		if (ecm_interface_is_vlan_dev(dev)) {
 			/*
 			 * VLAN master
 			 * GGG No locking needed here, ASSUMPTION is that real_dev is held for as long as we have dev.
 			 */
+			uint16_t dsa_vid = 0;
+
 			ether_addr_copy(type_info.vlan.address, dev->dev_addr);
-			type_info.vlan.vlan_tag = vlan_dev_vlan_id(dev);
-			type_info.vlan.vlan_tpid = ntohs(vlan_dev_vlan_proto(dev));
+			if (is_vlan_dev(dev)) {
+				type_info.vlan.vlan_tag = vlan_dev_vlan_id(dev);
+				type_info.vlan.vlan_tpid = ntohs(vlan_dev_vlan_proto(dev));
+			} else {
+				/*
+				 * A tag_8021q DSA port: the tagger's VID, standard TPID.
+				 */
+				ecm_interface_dsa_8021q_conduit(dev, &dsa_vid);
+				type_info.vlan.vlan_tag = dsa_vid;
+				type_info.vlan.vlan_tpid = ETH_P_8021Q;
+			}
 			DEBUG_TRACE("%px: Net device: %px is VLAN, mac: %pM, vlan_id: %x vlan_tpid: %x\n",
 					feci, dev, type_info.vlan.address, type_info.vlan.vlan_tag, type_info.vlan.vlan_tpid);
 
@@ -4005,7 +4085,7 @@
 				/*
 				 * VLAN?
 				 */
-				if (is_vlan_dev(dest_dev)) {
+				if (ecm_interface_is_vlan_dev(dest_dev)) {
 					/*
 					 * VLAN master
 					 * No locking needed here, ASSUMPTION is that real_dev is held for as long as we have dev.
@@ -5245,7 +5325,7 @@
 				/*
 				 * VLAN?
 				 */
-				if (is_vlan_dev(dest_dev)) {
+				if (ecm_interface_is_vlan_dev(dest_dev)) {
 					/*
 					 * VLAN master
 					 * No locking needed here, ASSUMPTION is that real_dev is held for as long as we have dev.
@@ -6199,7 +6279,7 @@
 				/*
 				 * VLAN?
 				 */
-				if (is_vlan_dev(dest_dev)) {
+				if (ecm_interface_is_vlan_dev(dest_dev)) {
 					/*
 					 * VLAN master
 					 * No locking needed here, ASSUMPTION is that real_dev is held for as long as we have dev.
@@ -6860,7 +6940,13 @@
 			stats.tx_packets = tx_packets;
 			stats.tx_bytes = tx_bytes;
 			DEBUG_INFO("vlan call to update status:rx pkt:%u tx pkt:%u", rx_packets, tx_packets);
-			__vlan_dev_update_accel_stats(dev, &stats);
+			/*
+			 * A tag_8021q DSA port is a VLAN iface here but not an 802.1Q
+			 * net device; it has no accel stats to update.
+			 */
+			if (is_vlan_dev(dev)) {
+				__vlan_dev_update_accel_stats(dev, &stats);
+			}
 			dev_put(dev);
 			continue;
 #endif
